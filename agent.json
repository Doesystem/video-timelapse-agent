{
    "name": "video-timelapse-agent",
    "version": "0.0.4",
    "description": "AI Agent สำหรับสร้างวิดีโอ timelapse แนวตั้ง 9:16 จากภาพสินค้า (TikTok / Instagram Reels / YouTube Shorts)",
    "runtime": "node20",
    "main": "dist/index.js",
    "public": true,
    "version_public": true,
    "pull_public": true,
    "input": {
        "type": "object",
        "hints": [
            "image_url", "product", "description", "category"
        ]
    },
    "output": {
        "type": "object",
        "hints": [
            "video_url", "status", "product", "category"
        ]
    },
    "capabilities": {
        "ai": {
            "required": true,
            "features": ["chat", "image"]
        }
    },
    "env": [
    ],
    "keywords": ["video", "timelapse", "short-video", "tiktok", "reels", "home", "furniture", "ai"]
}
